-- Профілювання non_org_installs_report: grain, діапазон дат, обсяг,
-- якість кандидатів на join-ключ (analytics_installation_id, campaign_id, media_source).
-- Інтерпретація результату — README.md, розділ 2.1.

-- Базові метрики: діапазон дат, обсяг, кількість унікальних кампаній/джерел
SELECT
  MIN(install_date) AS min_install_date,
  MAX(install_date) AS max_install_date,
  COUNT(*) AS row_count,
  COUNT(DISTINCT analytics_installation_id) AS distinct_installations,
  COUNT(DISTINCT campaign_id) AS distinct_campaigns,
  COUNT(DISTINCT media_source) AS distinct_media_sources
FROM `mornhouse-test-environment.test_app_dataset.non_org_installs_report`;

-- Follow-up: distinct_installations = 0 при 777724 рядках виглядає підозріло.
-- Перевірка NULL-rate analytics_installation_id.
SELECT
  COUNT(*) AS row_count,
  COUNTIF(analytics_installation_id IS NULL) AS null_installations,
  COUNTIF(analytics_installation_id IS NOT NULL) AS non_null_installations
FROM `mornhouse-test-environment.test_app_dataset.non_org_installs_report`;

-- Результат: analytics_installation_id = 100% NULL (777724/777724).
-- Висновок: непридатне як join-ключ з цієї таблиці. Див. Data Issues Log, README розділ 5.

-- Профілювання cost_table: grain, діапазон дат, обсяг,
-- якість campaign_id / media_source як кандидатів на join-ключ.
-- Порівняння з non_org_installs_report (54 кампанії, 3 media_source).
-- Інтерпретація результату — README.md, розділ 2.2.

SELECT
  MIN(date) AS min_date,
  MAX(date) AS max_date,
  COUNT(*) AS row_count,
  COUNT(DISTINCT app_id) AS distinct_apps,
  COUNT(DISTINCT campaign_id) AS distinct_campaigns,
  COUNT(DISTINCT media_source) AS distinct_media_sources,
  COUNTIF(campaign_id IS NULL) AS null_campaign_id,
  COUNTIF(media_source IS NULL) AS null_media_source
FROM `mornhouse-test-environment.test_app_dataset.cost_table`;

-- Результат: min_date/max_date збігається з non_org_installs_report (2026-06-01–2026-07-26).
-- row_count = 5 253 424 (набагато більше, ніж у installs) — очікувано, grain тут
-- campaign x adset x country/city x day, а не одна подія інсталу.
-- distinct_campaigns = 48 (installs: 54) — розбіжність, причина не з'ясована.
-- distinct_media_sources = 1 (installs: 3) — критична розбіжність, перевірено нижче.
-- null_campaign_id = 0, null_media_source = 0 — ключі структурно чисті.

-- Follow-up: порівняння реальних значень media_source між cost_table і non_org_installs_report —
-- чи це різне написання того самого джерела, чи реальна відсутність cost-даних для частини джерел.

SELECT 'cost_table' AS source_table, media_source, COUNT(*) AS row_count
FROM `mornhouse-test-environment.test_app_dataset.cost_table`
GROUP BY media_source

UNION ALL

SELECT 'non_org_installs_report' AS source_table, media_source, COUNT(*) AS row_count
FROM `mornhouse-test-environment.test_app_dataset.non_org_installs_report`
GROUP BY media_source

ORDER BY source_table, media_source;

